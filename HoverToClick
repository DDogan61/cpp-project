## 3. Fare bölümü — komple değişiyor

**ÖNCE**
```csharp
public event Action<FlameHoverInfo> HoverChanged;

protected override void OnMouseMove(MouseEventArgs e)
{
    base.OnMouseMove(e);

    Point p = e.GetPosition(this);
    FlameRun run = HitTest(p);
    LineSegment segment = run == null ? null : SegmentAt(run, p.X / _pxPerMs);

    // Ayni kutu ve ayni bolmedeysek olay tetiklemiyoruz; her fare
    // hareketinde arayuz guncellemek gereksiz.
    if (ReferenceEquals(run, _hover) && ReferenceEquals(segment, _hoverSegment)) return;

    _hover = run;
    _hoverSegment = segment;

    RaiseHover(run, segment);
}

protected override void OnMouseLeave(MouseEventArgs e)
{
    base.OnMouseLeave(e);

    if (_hover == null && _hoverSegment == null) return;

    _hover = null;
    _hoverSegment = null;

    RaiseHover(null, null);
}

private void RaiseHover(FlameRun run, LineSegment segment)
{
    Action<FlameHoverInfo> handler = HoverChanged;
    if (handler == null) return;

    if (run == null) { handler(null); return; }

    handler(new FlameHoverInfo
    {
        Name = run.Name,
        StartMs = run.StartMs,
        EndMs = run.EndMs,
        Line = segment == null ? 0 : segment.Line,
        LineStartMs = segment == null ? 0 : segment.StartMs,
        LineEndMs = segment == null ? 0 : segment.EndMs
    });
}
```

**SONRA** — `OnMouseMove` ve `OnMouseLeave` siliniyor, yerlerine bunlar:
```csharp
// Bir kutuya tiklaninca tetiklenir; bos alana tiklaninca null ile
// tetiklenir. Bilgiyi nerede gosterecegine cagiran karar verir.
public event Action<FlameSelectionInfo> SelectionChanged;

protected override void OnMouseLeftButtonDown(MouseButtonEventArgs e)
{
    base.OnMouseLeftButtonDown(e);

    Point p = e.GetPosition(this);

    _selected = HitTest(p);
    _selectedSegment = _selected == null ? null : SegmentAt(_selected, p.X / _pxPerMs);

    InvalidateVisual();   // cerceve
    RaiseSelection();

    e.Handled = true;
}

// ====================================================================
// Timer'dan cagriliyor.
//
// Secili run kosu boyunca uzuyor: kutu ayni kutu ama sure, bitis ve
// satir bolmesi degisiyor. Secim referansla tutuldugu icin tekrar
// hit-test'e gerek yok, bilgiyi yeniden yaymak yeterli.
// ====================================================================
public void RefreshSelection()
{
    if (_selected == null) return;

    RaiseSelection();
}

private void RaiseSelection()
{
    Action<FlameSelectionInfo> handler = SelectionChanged;
    if (handler == null) return;

    if (_selected == null) { handler(null); return; }

    handler(new FlameSelectionInfo
    {
        Name = _selected.Name,
        StartMs = _selected.StartMs,
        EndMs = _selected.EndMs,
        Line = _selectedSegment == null ? 0 : _selectedSegment.Line,
        LineStartMs = _selectedSegment == null ? 0 : _selectedSegment.StartMs,
        LineEndMs = _selectedSegment == null ? 0 : _selectedSegment.EndMs
    });
}
```

`RaiseHover` → `RaiseSelection`: parametreler kalkıyor, gövdede `run` → `_selected`,
`segment` → `_selectedSegment`. Gerisi birebir aynı.

`HitTest`, `SegmentAt`, `OnMouseWheel` değişmiyor.

